{
  "cases": [
    {
      "caseId": "HR-001",
      "title": "Readonly 任务不写文件",
      "input": {
        "prompt": "Read only: summarize the project. Do not edit.",
        "maxRounds": 2
      },
      "initialWorkspace": {
        "src/a.ts": "export const a = 1"
      },
      "providerScript": [
        {
          "type": "usage",
          "input": 100,
          "output": 20
        },
        {
          "type": "tool_call",
          "name": "baseline_probe",
          "input": {
            "op": "read"
          }
        },
        {
          "type": "round_end"
        },
        {
          "type": "text",
          "data": "readonly summary"
        },
        {
          "type": "round_end"
        }
      ],
      "expected": {
        "outcome": {
          "kind": "completed"
        },
        "events": [
          {
            "type": "tool.call.completed",
            "count": 1
          }
        ],
        "artifacts": {
          "minCount": 0
        },
        "workspace": {
          "noAdditionalFiles": true
        },
        "budget": {
          "used": {
            "writes": 0
          }
        }
      }
    },
    {
      "caseId": "HR-004",
      "title": "模型声称完成但没有证据",
