      "caseId": "HR-019",
      "title": "权限拒绝高风险工具",
      "input": {
        "prompt": "run the shell command",
        "maxRounds": 3
      },
      "initialWorkspace": {
        ".orcana/permissions.json": "{\"rules\":[{\"toolName\":\"shell\",\"level\":\"deny\",\"reason\":\"hr019\"}]}"
      },
      "toolScript": [
        {
          "toolName": "shell",
          "steps": [
            {
              "content": "should not run"
            }
          ]
        },
        {
          "toolName": "baseline_probe",
          "steps": [
            {
              "content": "ok"
            }
          ]
        }
      ],
      "providerScript": [
        {
          "type": "usage",
          "input": 100,
          "output": 20
        },
        {
          "type": "tool_call",
          "name": "shell",
          "input": {
            "command": "rm -rf /tmp/x"
          }
        },
        {
          "type": "round_end"
        },
        {
          "type": "usage",
          "input": 50,
          "output": 10
        },
        {
          "type": "tool_call",
          "name": "baseline_probe",
          "input": {}
        },
        {
          "type": "round_end"
        },
        {
          "type": "text",
          "data": "shell was blocked"
        },
        {
          "type": "round_end"
        }
      ],
      "expected": {
        "outcome": {
          "kind": "completed"
        },
        "events": [
          {
            "type": "tool.call.requested",
            "minCount": 2
          },
          {
            "type": "tool.call.completed",
            "count": 1
          }
        ],
        "artifacts": {
          "minCount": 0
        },
        "workspace": {},
        "budget": {
          "used": {
            "toolCalls": 2
          }
        }
      }
