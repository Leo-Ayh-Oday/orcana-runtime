    {
      "caseId": "HR-005",
      "title": "Typecheck 失败后定向修复",
      "input": {
        "prompt": "fix the type error",
        "maxRounds": 3
      },
      "initialWorkspace": {
        "src/a.ts": "export const a: number = 'x'"
      },
      "toolScript": [
        {
          "toolName": "run_typecheck",
          "steps": [
            {
              "content": "error TS2322: Type 'string' is not assignable to type 'number'",
              "success": false
            },
            {
              "content": "no errors",
              "success": true
            }
          ]
        }
      ],
      "providerScript": [
        {
          "type": "usage",
          "input": 100,
          "output": 20
        },
        {
          "type": "tool_call",
          "name": "run_typecheck",
          "input": {}
        },
        {
          "type": "round_end"
        },
        {
          "type": "usage",
          "input": 50,
          "output": 10
        },
        {
          "type": "tool_call",
          "name": "run_typecheck",
          "input": {}
        },
        {
          "type": "round_end"
        },
        {
          "type": "text",
          "data": "fixed"
        },
        {
          "type": "round_end"
        }
      ],
      "expected": {
        "outcome": {
          "kind": "blocked"
        },
        "events": [
          {
            "type": "tool.call.completed",
            "count": 2
          }
        ],
        "artifacts": {
          "minCount": 0
        },
        "workspace": {}
      }
    },
